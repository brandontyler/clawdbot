# Optional machine-local overrides for kiro-proxy-heartbeat.service.
# Copy to /home/ubuntu/.config/openclaw/health-monitor.env.

# Phase A (default): publish metrics and capture incidents, but never restart.
OPENCLAW_HEALTH_RECOVERY_MODE=diagnostic

# Phase B after a successful soak: permit one gateway-only restart when
# /healthz fails three times, the proxy is healthy, and no ACP session prompts.
# OPENCLAW_HEALTH_RECOVERY_MODE=restart

OPENCLAW_HEALTH_FAILURE_THRESHOLD=3
OPENCLAW_HEALTH_RECOVERY_COOLDOWN_SECS=1800
OPENCLAW_HEALTH_PROBE_TIMEOUT_SECS=5
OPENCLAW_HEALTH_RECOVERY_HEALTH_ATTEMPTS=30
OPENCLAW_HEALTH_RECOVERY_READY_ATTEMPTS=30
