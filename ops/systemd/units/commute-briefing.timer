[Unit]
Description=Run commute briefing weekday mornings

[Timer]
# AM: 5:30am CDT Mon-Fri — ~30min before the 6:00am outbound departure.
# PM: 2:45pm CDT Mon-Wed — ~30min before the 3:15pm inbound departure.
# The script auto-detects direction by clock (AM before noon → outbound leg,
# PM after noon → inbound leg) so a single service serves both runs. Computing
# the inbound leg in the AM was useless — Google returns only a historical
# average for a departure ~10h out, not live conditions.
OnCalendar=Mon..Fri *-*-* 05:30:00
OnCalendar=Mon..Wed *-*-* 14:45:00
Persistent=true

[Install]
WantedBy=timers.target
