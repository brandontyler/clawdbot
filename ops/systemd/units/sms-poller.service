[Unit]
Description=SMS Commute Notes Poller (SQS → bead + Discord)
After=network-online.target openclaw-gateway.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
Environment=SMS_POLLER_AWS_PROFILE=isengard
Environment=SMS_POLLER_PROJECT_DIR=/home/ubuntu/openclaw
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/openclaw/scripts/sms-poller.sh
WorkingDirectory=/home/ubuntu/openclaw
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
