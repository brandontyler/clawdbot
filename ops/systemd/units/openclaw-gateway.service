[Unit]
Description=OpenClaw Gateway (EC2)
After=network-online.target kiro-proxy.service
Wants=network-online.target
Requires=kiro-proxy.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStartPre=/home/ubuntu/openclaw/scripts/verify-gateway-dist.sh
ExecStartPre=/bin/sleep 5
ExecStart=/home/ubuntu/openclaw/run-gateway.sh --verbose --force --port 18800 --bind loopback
Restart=always
RestartSec=5

# Memory caps (openclaw-d1g step 3, 2026-06-29). Sized from observed peaks
# on t4g.large: current 650 MB, peak 1.2 GB. 1.5 GB cap leaves generous
# headroom while bounding any leak. MemoryHigh applies pressure before
# the hard kill.
MemoryHigh=1200M
MemoryMax=1500M

[Install]
WantedBy=default.target
