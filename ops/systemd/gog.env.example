# gog.env — environment variables for systemd user services that need
# Google Workspace (gog CLI) keyring access.
#
# Copy this file to ~/.config/systemd/user/gog.env, fill in the password,
# and set permissions to 600:
#   cp gog.env.example ~/.config/systemd/user/gog.env
#   chmod 600 ~/.config/systemd/user/gog.env
#
# This file is referenced by services via EnvironmentFile=. It MUST NOT be
# committed to git (the local copy has a real password).

GOG_KEYRING_PASSWORD=replace_me
